<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hushcue.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hushcue.Controls"
    xmlns:pages="using:Hushcue.Pages"
    Title="Hushcue">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the app, its two tools, and where the work runs -->
        <TitleBar x:Name="AppTitleBar" Title="Hushcue" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE7F0;" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <SelectorBar x:Name="Modes" SelectionChanged="OnModeChanged" AutomationProperties.Name="Tool">
                    <SelectorBarItem x:Name="GenerateItem" Text="Generate subtitles"
                                     ToolTipService.ToolTip="Make subtitles for videos and audio files">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xED1E;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="ConvertItem" Text="MKV to MP4"
                                     ToolTipService.ToolTip="Remove the subtitle tracks from .mkv files and save them as .mp4">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE8AB;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <!-- "Offline · RTX 4070": everything runs here; opens the system check -->
                <Button x:Name="Badge" Click="OnBadgeClick" Padding="10,4" Margin="0,0,4,0" CornerRadius="12"
                        BorderThickness="0" VerticalAlignment="Center" Visibility="Collapsed"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="BadgeIcon" Glyph="&#xE72E;" FontSize="12"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="BadgeText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid Grid.Row="1" Padding="20,2,20,16">
            <pages:GeneratePage x:Name="Generate" />
            <pages:ConvertPage x:Name="Convert" Visibility="Collapsed" />
            <controls:SetupView x:Name="Setup" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
