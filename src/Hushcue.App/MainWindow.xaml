<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hushcue.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hushcue.Controls"
    xmlns:pages="using:Hushcue.Pages"
    Title="Hushcue">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" PreviewKeyDown="OnPreviewKeyDown" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the app, and where the work runs -->
        <TitleBar x:Name="AppTitleBar" Title="Hushcue" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE7F0;" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <!-- "Offline · RTX 4070": everything runs here; opens the system check -->
                <Button x:Name="Badge" Click="OnBadgeClick" Padding="10,4" Margin="0,0,4,0" CornerRadius="12"
                        BorderThickness="0" VerticalAlignment="Center" Visibility="Collapsed"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="BadgeIcon" Glyph="&#xE72E;" FontSize="12"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="BadgeText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- The app's three tools in a sidebar, with Settings and About at the bottom -->
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True" OpenPaneLength="232" CompactModeThresholdWidth="760"
                        ExpandedModeThresholdWidth="1100" SelectionChanged="OnNavSelectionChanged"
                        AutomationProperties.Name="Tools">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GenerateItem" Content="Generate subtitles"
                                    ToolTipService.ToolTip="Make subtitles for videos and audio files">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED1E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="EditItem" Content="Edit subtitles"
                                    ToolTipService.ToolTip="Open a video with its .srt and fix the text and timing">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ConvertItem" Content="MKV to MP4"
                                    ToolTipService.ToolTip="Remove the subtitle tracks from .mkv files and save them as .mp4">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutItem" Content="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Very wide screens: the pages stop growing and stay centred -->
            <Grid Padding="20,8,20,16" MaxWidth="2560">
                <pages:GeneratePage x:Name="Generate" />
                <pages:EditPage x:Name="Edit" Visibility="Collapsed" />
                <pages:ConvertPage x:Name="Convert" Visibility="Collapsed" />
                <pages:SettingsPage x:Name="SettingsView" Visibility="Collapsed" />
                <pages:AboutPage x:Name="About" Visibility="Collapsed" />
                <controls:SetupView x:Name="Setup" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
