<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hushcue.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Hushcue.Pages"
    Title="Hushcue">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Padding="28,18,28,22" RowSpacing="18" AllowDrop="True"
          DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="TaglineText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <SelectorBar x:Name="Modes" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="OnModeChanged"
                         AutomationProperties.Name="Mode">
                <SelectorBarItem x:Name="GenerateItem" Text="Generate subtitles">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE7F0;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="ConvertItem" Text="MKV to MP4">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
        </Grid>

        <Grid Grid.Row="1">
            <pages:GeneratePage x:Name="Generate" />
            <pages:ConvertPage x:Name="Convert" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
