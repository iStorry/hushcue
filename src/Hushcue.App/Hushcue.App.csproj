<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Hushcue</RootNamespace>
    <AssemblyName>Hushcue</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Hushcue.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, with the Windows App SDK runtime copied next to the exe: no separate runtime install for users. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Program.cs has the entry point: a second launch hands its files to the running app -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WinUI component only; the Microsoft.WindowsAppSDK metapackage also pulls in AI, ML, Search and Widgets. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- WinUI 2.3.9 asks for 2.1.8, which was never published; 2.1.9 is what Windows App SDK 2.5.1 ships. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hushcue.Core\Hushcue.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Made by tools/make-icon.ps1; also loaded at runtime for the window's title bar -->
    <Content Include="Assets\Hushcue.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
