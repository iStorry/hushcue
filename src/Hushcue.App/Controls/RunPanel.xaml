<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Controls.RunPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hushcue.Controls">

    <StackPanel Spacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- No room for the status beside the buttons: it goes above them -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <local:WidthTrigger Element="{x:Bind Layout}" Below="560" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Layout.RowSpacing" Value="10" />
                        <Setter Target="Status.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="Actions.(Grid.Row)" Value="1" />
                        <Setter Target="Actions.(Grid.Column)" Value="0" />
                        <Setter Target="Actions.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="Layout" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="Status" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Status" />
                <ProgressBar x:Name="Bar" Maximum="1000" Value="0" Visibility="Collapsed"
                             AutomationProperties.Name="Overall progress" />
            </StackPanel>
            <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <HyperlinkButton x:Name="LogToggle" Content="Show log" VerticalAlignment="Center" Click="OnToggleLog" />
                <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="OnCancel"
                        MinWidth="96" VerticalAlignment="Center" ToolTipService.ToolTip="Stop the run (Esc)" AutomationProperties.AcceleratorKey="Escape">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" Invoked="OnCancelShortcut" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="StartButton" MinWidth="200" Padding="22,9" Click="OnStart"
                        Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="Start (Ctrl+Enter)"
                        AutomationProperties.AcceleratorKey="Control+Enter" />
            </StackPanel>
        </Grid>
        <TextBox x:Name="LogBox" Visibility="Collapsed" Height="130" IsReadOnly="True" TextWrapping="NoWrap"
                 AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Log" />
    </StackPanel>
</UserControl>
