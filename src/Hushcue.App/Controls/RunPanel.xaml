<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Controls.RunPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite" />
                    <HyperlinkButton x:Name="LogToggle" Content="Show log" HorizontalAlignment="Right" Padding="4,0"
                                     Click="OnToggleLog" />
                </Grid>
                <ProgressBar x:Name="Bar" Maximum="1000" Value="0" AutomationProperties.Name="Progress" />
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" IsEnabled="False" Click="OnCancel"
                    VerticalAlignment="Center" />
            <Button x:Name="StartButton" Grid.Column="2" MinWidth="220" Padding="22,10" Click="OnStart"
                    Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" />
        </Grid>
        <TextBox x:Name="LogBox" Visibility="Collapsed" Height="130" IsReadOnly="True" TextWrapping="NoWrap"
                 AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Log" />
    </StackPanel>
</UserControl>
