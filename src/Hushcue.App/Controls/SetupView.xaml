<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Controls.SetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hushcue.Controls">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <!-- at least as tall as the window, so the card sits in the middle of it -->
        <Grid MinHeight="{Binding ViewportHeight, ElementName=Scroller}">
        <Border Style="{StaticResource Card}" MaxWidth="600" Margin="0,12" Padding="28,24,28,24"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="Heading" Text="Set up Hushcue" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="Everything runs on this PC. Nothing is uploaded." Style="{StaticResource Hint}" />
                </StackPanel>

                <StackPanel Spacing="16">
                    <local:CheckRow x:Name="GpuRow" />
                    <!-- The GPU libraries (cuBLAS, NVRTC): only with a CUDA device -->
                    <StackPanel Spacing="10">
                        <local:CheckRow x:Name="GpuRuntimeRow" Visibility="Collapsed" />
                        <StackPanel x:Name="RuntimePanel" Spacing="6" Margin="32,0,0,0" Visibility="Collapsed">
                            <ProgressBar x:Name="RuntimeBar" Maximum="1000" AutomationProperties.Name="GPU libraries download" />
                            <TextBlock x:Name="RuntimeText" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Button x:Name="RuntimeButton" Margin="32,0,0,0" Visibility="Collapsed" Click="OnRuntimeDownload" />
                    </StackPanel>
                    <local:CheckRow x:Name="FfmpegRow" />
                    <StackPanel Spacing="10">
                        <local:CheckRow x:Name="ModelRow" />
                        <StackPanel x:Name="DownloadPanel" Spacing="6" Margin="32,0,0,0" Visibility="Collapsed">
                            <ProgressBar x:Name="DownloadBar" Maximum="1000" AutomationProperties.Name="Model download" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DownloadText" Style="{StaticResource Hint}" />
                                <TextBlock Grid.Column="1" Text="resumes if closed" Style="{StaticResource Hint}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RecheckButton" Content="Check again" Click="OnRecheck" VerticalAlignment="Top" />
                    <local:WrapPanel Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Right">
                        <Button x:Name="DownloadButton" Click="OnDownload" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Name="ContinueButton" Content="Continue" MinWidth="120" IsEnabled="False"
                                Style="{ThemeResource AccentButtonStyle}" Click="OnContinue" />
                    </local:WrapPanel>
                </Grid>
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
