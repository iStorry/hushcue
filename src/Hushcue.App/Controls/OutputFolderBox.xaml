<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Controls.OutputFolderBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FolderText" PlaceholderText="Same folder as each input file"
                 AutomationProperties.Name="Output folder" />
        <Button Grid.Column="1" Content="Browse" Click="OnBrowse" />
    </Grid>
</UserControl>
