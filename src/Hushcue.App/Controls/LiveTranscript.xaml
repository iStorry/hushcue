<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Controls.LiveTranscript"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hushcue.Controls">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock x:Name="TitleText" Text="LIVE TRANSCRIPT" Style="{StaticResource CardTitle}" Margin="0"
                       AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="FileText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource Hint}" VerticalAlignment="Center"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Text="Subtitles appear here as the file is transcribed." />
        <ListView x:Name="List" Grid.Row="1" SelectionMode="None" Margin="-12,0" AutomationProperties.Name="Subtitles heard so far">
            <!-- no fade-in per line: with lines arriving every few seconds it made the list blink -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CueLine">
                    <Grid Padding="0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Time}" FontFamily="Cascadia Mono, Consolas"
                                   Style="{StaticResource CaptionTextBlockStyle}" Margin="0,2,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
