<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Pages.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hushcue.Controls"
    xmlns:pages="using:Hushcue.Pages">

    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <!-- the player's buttons: one size, whatever they show -->
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Width" Value="104" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" RowSpacing="12" PreviewKeyDown="OnPreviewKeyDown">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- Too narrow for the video and the list side by side: the list goes under the video, the page
                     scrolls, and the buttons at the bottom go under the status -->
                <VisualState x:Name="Stacked">
                    <VisualState.StateTriggers>
                        <controls:WidthTrigger Element="{x:Bind Root}" Below="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Scroller.(controls:ScrollFill.MinHeight)" Value="900" />
                        <Setter Target="Panes.ColumnSpacing" Value="0" />
                        <Setter Target="Panes.RowSpacing" Value="12" />
                        <Setter Target="ListColumn.Width" Value="0" />
                        <Setter Target="ListColumn.MinWidth" Value="0" />
                        <Setter Target="VideoCard.(Grid.RowSpan)" Value="1" />
                        <Setter Target="ListCard.(Grid.Column)" Value="0" />
                        <Setter Target="ListCard.(Grid.Row)" Value="1" />
                        <Setter Target="ListCard.(Grid.RowSpan)" Value="1" />
                        <Setter Target="Footer.RowSpacing" Value="8" />
                        <Setter Target="Footer.ColumnSpacing" Value="0" />
                        <Setter Target="FooterActions.(Grid.Row)" Value="1" />
                        <Setter Target="FooterActions.(Grid.Column)" Value="0" />
                        <Setter Target="FooterActions.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Which file, and the way back -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBack" Style="{ThemeResource SubtleButtonStyle}" Padding="8,6"
                    ToolTipService.ToolTip="Back to the files" AutomationProperties.Name="Back to the files">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Files" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="FileTitle" Grid.Column="1" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="FileFacts" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Side by side the page fits the window down to a short one; stacked it needs more height -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" controls:ScrollFill.MinHeight="460">
        <Grid x:Name="Panes" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition x:Name="ListColumn" Width="2*" MinWidth="340" MaxWidth="620" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Video with the subtitle drawn over it, the controls, and the timeline -->
            <Border x:Name="VideoCard" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="16,16,16,12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="VideoArea" Background="Black" CornerRadius="6" MinHeight="120" Tapped="OnVideoTapped"
                          SizeChanged="OnVideoAreaSizeChanged">
                        <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False" Stretch="Uniform"
                                            AutomationProperties.Name="Video preview" />
                        <TextBlock x:Name="VideoMessage" Foreground="#FFB0B0B0" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
                        <Border x:Name="Overlay" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,20"
                                Padding="12,5" CornerRadius="4" Background="#D0000000" Visibility="Collapsed">
                            <TextBlock x:Name="OverlayText" Foreground="White" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackStep" Click="OnStepBack" Style="{StaticResource TransportButton}"
                                ToolTipService.ToolTip="Back 5 seconds (J)" AutomationProperties.Name="Back 5 seconds"
                                AutomationProperties.AcceleratorKey="J">
                            <TextBlock Text="−5 s" />
                        </Button>
                        <Button x:Name="PlayButton" Grid.Column="1" Click="OnPlay" Style="{StaticResource TransportButton}"
                                ToolTipService.ToolTip="Play (Space or K)" AutomationProperties.Name="Play"
                                AutomationProperties.AcceleratorKey="Space">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="14" />
                        </Button>
                        <Button x:Name="ForwardStep" Grid.Column="2" Click="OnStepForward" Style="{StaticResource TransportButton}"
                                ToolTipService.ToolTip="Forward 5 seconds (L)" AutomationProperties.Name="Forward 5 seconds"
                                AutomationProperties.AcceleratorKey="L">
                            <TextBlock Text="+5 s" />
                        </Button>
                        <Button x:Name="VolumeButton" Grid.Column="3" Style="{StaticResource TransportButton}"
                                ToolTipService.ToolTip="Volume (M mutes)" AutomationProperties.Name="Volume"
                                AutomationProperties.AcceleratorKey="M">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE995;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="MuteButton" Click="OnMute" Style="{ThemeResource SubtleButtonStyle}" Padding="8"
                                                ToolTipService.ToolTip="Mute (M)" AutomationProperties.Name="Mute">
                                            <FontIcon x:Name="MuteIcon" Glyph="&#xE74F;" FontSize="14" />
                                        </Button>
                                        <Slider x:Name="VolumeSlider" Width="160" Minimum="0" Maximum="100" StepFrequency="1"
                                                VerticalAlignment="Center" ValueChanged="OnVolumeChanged"
                                                AutomationProperties.Name="Volume" />
                                        <TextBlock x:Name="VolumeText" Width="36" VerticalAlignment="Center" TextAlignment="Right"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock x:Name="TimeText" Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="6" Click="OnZoomOut" Style="{ThemeResource SubtleButtonStyle}" Padding="8"
                                ToolTipService.ToolTip="Show more of the timeline (Ctrl+wheel)" AutomationProperties.Name="Zoom the timeline out">
                            <FontIcon Glyph="&#xE71F;" FontSize="14" />
                        </Button>
                        <Button Grid.Column="7" Click="OnZoomIn" Style="{ThemeResource SubtleButtonStyle}" Padding="8"
                                ToolTipService.ToolTip="Show less of the timeline, in more detail (Ctrl+wheel)"
                                AutomationProperties.Name="Zoom the timeline in">
                            <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                        </Button>
                    </Grid>

                    <controls:WaveformTimeline x:Name="Timeline" Grid.Row="2" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Hint}"
                               Text="Drag the edges of a subtitle to fix its timing · click to play from there · wheel to scroll, Ctrl+wheel to zoom" />
                </Grid>
            </Border>

            <!-- The subtitles: search, flags, the list, and the selected one's editor -->
            <Border x:Name="ListCard" Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,12,16,8" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" PlaceholderText="Find in transcript (Ctrl+F)" TextChanged="OnSearchChanged"
                                 KeyDown="OnSearchKeyDown" AutomationProperties.Name="Find in transcript"
                                 AutomationProperties.AcceleratorKey="Control+F" />
                        <Button x:Name="FlagsButton" Grid.Column="1" Click="OnNextFlag" Padding="10,5"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                ToolTipService.ToolTip="Go to the next thing to check (F8; Shift+F8 goes back)"
                                AutomationProperties.AcceleratorKey="F8">
                            <TextBlock x:Name="FlagsText" />
                        </Button>
                        <Button x:Name="PreviousFlagButton" Grid.Column="2" Click="OnPreviousFlag" Style="{ThemeResource SubtleButtonStyle}"
                                Padding="8" ToolTipService.ToolTip="Previous thing to check (Shift+F8)"
                                AutomationProperties.Name="Previous thing to check">
                            <FontIcon Glyph="&#xE70E;" FontSize="12" />
                        </Button>
                    </Grid>

                    <ListView x:Name="CueList" Grid.Row="1" SelectionMode="Extended" SelectionChanged="OnRowSelected"
                              AutomationProperties.Name="Subtitles" Padding="0,0,0,8">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pages:ReviewRow">
                                <Grid Padding="0,7" ColumnSpacing="10" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{x:Bind MarkerBrush, Mode=OneWay}" CornerRadius="2" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Time, Mode=OneWay}" MinWidth="64" Margin="0,1,0,0"
                                               FontFamily="Cascadia Mono, Consolas" FontWeight="{x:Bind TimeWeight, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap"
                                                   FontStyle="{x:Bind TextStyle, Mode=OneWay}" Foreground="{x:Bind TextBrush, Mode=OneWay}" />
                                        <Border Visibility="{x:Bind FlagVisibility, Mode=OneWay}" HorizontalAlignment="Left"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind FlagLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Padding="16,12,16,14">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="EditorTitle" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="StartBox" Grid.Column="1" Style="{StaticResource TimeBox}"
                                         KeyDown="OnTimeKeyDown" LostFocus="OnTimeLostFocus"
                                         ToolTipService.ToolTip="Start (minutes:seconds)" AutomationProperties.Name="Start time" />
                                <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <TextBox x:Name="EndBox" Grid.Column="3" Style="{StaticResource TimeBox}"
                                         KeyDown="OnTimeKeyDown" LostFocus="OnTimeLostFocus"
                                         ToolTipService.ToolTip="End (minutes:seconds)" AutomationProperties.Name="End time" />
                            </Grid>
                            <TextBox x:Name="TextEditor" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="56"
                                     KeyDown="OnTextKeyDown" LostFocus="OnTextLostFocus"
                                     PlaceholderText="Select a subtitle to edit it"
                                     AutomationProperties.Name="Subtitle text (Enter to save the change, Esc to undo it)" />
                            <Grid x:Name="FlagPanel" ColumnSpacing="8" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock x:Name="FlagMessage" Grid.Column="1" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           AutomationProperties.LiveSetting="Polite" />
                                <HyperlinkButton Grid.Column="2" Content="Looks fine" Click="OnDismissFlag" Padding="4,0"
                                                 ToolTipService.ToolTip="Stop flagging this" AutomationProperties.Name="Looks fine: stop flagging this" />
                            </Grid>
                            <!-- one-click swaps for words that sound like others: "calm → come  cum" (ShowSwaps) -->
                            <StackPanel x:Name="SwapPanel" Spacing="4" Visibility="Collapsed"
                                        AutomationProperties.Name="Words that sound like others" />
                            <!-- what another quality's model heard in a stretch, next to what is there now (CompareWith) -->
                            <Border x:Name="ComparePanel" Visibility="Collapsed" CornerRadius="6" Padding="12,10" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="CompareTitle" Style="{StaticResource CardTitle}" Margin="0" TextWrapping="Wrap" />
                                    <!-- long stretches scroll here, so the list above keeps its room -->
                                    <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
                                    <Grid ColumnSpacing="10" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="CompareBeforeLabel" Text="Now" Margin="0,1,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="CompareBefore" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   AutomationProperties.Name="The subtitles there now" />
                                        <TextBlock x:Name="CompareAfterLabel" Grid.Row="1" Margin="0,1,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="CompareAfter" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Grid>
                                    </ScrollViewer>
                                    <TextBlock x:Name="CompareSummary" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                    <controls:WrapPanel HorizontalSpacing="4" VerticalSpacing="4">
                                        <Button x:Name="UseCompareButton" Click="OnUseComparison" Style="{ThemeResource AccentButtonStyle}" Padding="10,5">
                                            <TextBlock x:Name="UseCompareText" />
                                        </Button>
                                        <Button x:Name="KeepCompareButton" Click="OnKeepCurrent" Style="{StaticResource ToolButton}" Content="Keep current"
                                                ToolTipService.ToolTip="Leave the subtitles as they are" />
                                        <Button x:Name="PlayCompareButton" Click="OnPlayComparison" Style="{StaticResource ToolButton}">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                        </Button>
                                    </controls:WrapPanel>
                                </StackPanel>
                            </Border>
                            <controls:WrapPanel HorizontalSpacing="4" VerticalSpacing="4">
                                <Button x:Name="SplitButton" Click="OnSplit" Style="{StaticResource ToolButton}"
                                        ToolTipService.ToolTip="Split in two at the cursor in the text"
                                        AutomationProperties.Name="Split this subtitle in two">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C6;" FontSize="12" />
                                        <TextBlock Text="Split" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MergeButton" Click="OnMerge" Style="{StaticResource ToolButton}"
                                        ToolTipService.ToolTip="Join with the next subtitle" AutomationProperties.Name="Join with the next subtitle">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C9;" FontSize="12" />
                                        <TextBlock Text="Merge" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AddButton" Click="OnAdd" Style="{StaticResource ToolButton}"
                                        ToolTipService.ToolTip="Add a subtitle at the playhead" AutomationProperties.Name="Add a subtitle at the playhead">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                </Button>
                                <Button x:Name="DeleteButton" Click="OnDelete" Style="{StaticResource ToolButton}"
                                        ToolTipService.ToolTip="Delete the selected subtitles (Delete)"
                                        AutomationProperties.Name="Delete the selected subtitles" AutomationProperties.AcceleratorKey="Delete">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                                <Button x:Name="RerunButton" Click="OnRerun" Style="{StaticResource ToolButton}"
                                        ToolTipService.ToolTip="Transcribe the selected stretch again and replace its subtitles (undo with Ctrl+Z)"
                                        AutomationProperties.Name="Re-run this part">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="RerunIcon" Glyph="&#xE72C;" FontSize="12" />
                                        <TextBlock Text="Re-run this part" />
                                    </StackPanel>
                                </Button>
                                <DropDownButton x:Name="CompareButton" Padding="10,5"
                                                ToolTipService.ToolTip="Transcribe the selected stretch with another quality's model and compare before using it"
                                                AutomationProperties.Name="Try another model">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8AB;" FontSize="12" />
                                        <TextBlock Text="Try another model" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="CompareMenu" Placement="Top" Opening="OnCompareMenuOpening" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- Saving, and putting the subtitles into the video as the last step -->
        <Grid x:Name="Footer" Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="WorkBar" Maximum="1000" Visibility="Collapsed" AutomationProperties.Name="Progress" />
                <StackPanel x:Name="ResultLinks" Orientation="Horizontal" Margin="-12,-4,0,0" Visibility="Collapsed">
                    <HyperlinkButton x:Name="ShowOutputLink" Content="Show in folder" Click="OnShowOutput" />
                    <HyperlinkButton x:Name="RestoreLink" Content="Put the original back" Click="OnRestore" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
            <controls:WrapPanel x:Name="FooterActions" Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Click="OnUndo" Style="{ThemeResource SubtleButtonStyle}" Padding="9"
                        AutomationProperties.AcceleratorKey="Control+Z">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                </Button>
                <Button x:Name="RedoButton" Click="OnRedo" Style="{ThemeResource SubtleButtonStyle}" Padding="9"
                        AutomationProperties.AcceleratorKey="Control+Y">
                    <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                </Button>
                <Button x:Name="SaveButton" Click="OnSave" ToolTipService.ToolTip="Save the .srt (Ctrl+S)"
                        AutomationProperties.Name="Save" AutomationProperties.AcceleratorKey="Control+S">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Content="Export .srt" Click="OnExport"
                        ToolTipService.ToolTip="Save a copy of the subtitles somewhere else" AutomationProperties.Name="Export .srt" />
                <!-- A preview: discard it, or keep it as the result chosen here -->
                <Button x:Name="DiscardButton" Click="OnDiscard" Visibility="Collapsed"
                        ToolTipService.ToolTip="Delete this preview; nothing is saved" AutomationProperties.Name="Discard the preview">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Discard" />
                    </StackPanel>
                </Button>
                <!-- Items from ReviewPage.ShowModes: with an .srt of its own for a preview -->
                <ComboBox x:Name="ModeBox" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnModeChanged"
                          AutomationProperties.Name="How to put the subtitles into the video" />
                <Button x:Name="EmbedButton" Click="OnEmbed" Style="{ThemeResource AccentButtonStyle}" Padding="18,6"
                        AutomationProperties.Name="Embed into video">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="EmbedIcon" Glyph="&#xE8B9;" FontSize="14" />
                        <TextBlock x:Name="EmbedText" Text="Embed into video" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelWork" Visibility="Collapsed" />
            </controls:WrapPanel>
        </Grid>
    </Grid>
</UserControl>
