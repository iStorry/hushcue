<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Pages.GeneratePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hushcue.Controls"
    xmlns:pages="using:Hushcue.Pages">

    <UserControl.Resources>
        <DataTemplate x:Key="ResultCard" x:DataType="pages:ResultChoice">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Hint}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="INPUT" Style="{StaticResource CardTitle}" />
                        <controls:FileQueue x:Name="Queue" Grid.Row="1" EmptyText="Drop videos or audio here" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource CardTitle}" />
                        <controls:OutputFolderBox x:Name="Output" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <TextBlock Text="OPTIONS" Style="{StaticResource CardTitle}" Margin="0" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="Quality" />
                            <!-- One card per preset, added from Presets.All -->
                            <Grid x:Name="PresetChoices" ColumnSpacing="6" XYFocusKeyboardNavigation="Enabled"
                                  TabFocusNavigation="Once" AutomationProperties.Name="Quality">
                                <Grid.Resources>
                                    <Style TargetType="RadioButton" BasedOn="{StaticResource ChoiceCard}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </Grid.Resources>
                            </Grid>
                            <TextBlock x:Name="PresetHint" Style="{StaticResource Hint}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Result" />
                            <StackPanel x:Name="ResultChoices" Spacing="6" XYFocusKeyboardNavigation="Enabled"
                                        TabFocusNavigation="Once" AutomationProperties.Name="Result">
                                <StackPanel.Resources>
                                    <Style TargetType="RadioButton" BasedOn="{StaticResource ChoiceCard}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ResultCard}" />
                                    </Style>
                                </StackPanel.Resources>
                                <RadioButton Checked="OnResultChanged" AutomationProperties.Name="Subtitle file">
                                    <pages:ResultChoice Mode="None" Glyph="&#xE8A5;" Title="Subtitle file (.srt)"
                                                        Detail="A separate file that most players pick up" />
                                </RadioButton>
                                <RadioButton Checked="OnResultChanged" AutomationProperties.Name="Subtitle track">
                                    <pages:ResultChoice Mode="Soft" Glyph="&#xE714;" Title="Subtitle track (.mkv)"
                                                        Detail="Instant and lossless; can be switched off in the player" />
                                </RadioButton>
                                <RadioButton Checked="OnResultChanged" AutomationProperties.Name="Burn into the picture">
                                    <pages:ResultChoice Mode="Burn" Glyph="&#xE8B9;" Title="Burn into the picture (.mp4)"
                                                        Detail="Works in every player; permanent, re-encodes the video" />
                                </RadioButton>
                            </StackPanel>
                            <CheckBox x:Name="KeepSrtBox" Content="Also keep the .srt file" />
                            <CheckBox x:Name="DeleteBox" Content="Move the original video to the Recycle Bin when done"
                                      ToolTipService.ToolTip="Only after the new video has been written successfully. Recoverable from the Recycle Bin." />
                        </StackPanel>

                        <Expander x:Name="MoreOptions" Header="More options" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="14">
                                <ComboBox x:Name="LanguageBox" Header="Language" HorizontalAlignment="Stretch" />
                                <TextBox x:Name="VocabularyBox" Header="Vocabulary"
                                         PlaceholderText="Names or words to spell correctly, comma separated" />
                                <StackPanel>
                                    <CheckBox x:Name="EnhanceBox" Content="Clean up audio first (denoise + normalize)" />
                                    <CheckBox x:Name="SkipSilenceBox" Content="Skip silent parts (faster, may drop quiet speech)" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <controls:RunPanel x:Name="Run" Grid.Row="1" StartText="Generate subtitles" />
    </Grid>
</UserControl>
