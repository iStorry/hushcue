<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Pages.GeneratePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hushcue.Controls"
    xmlns:pages="using:Hushcue.Pages">

    <UserControl.Resources>
        <DataTemplate x:Key="ResultCard" x:DataType="pages:ResultChoice">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Hint}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <Grid x:Name="Main" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Files | options; on a wide window a third column keeps the live transcript or the finished summary next
             to the options instead of in their place (GeneratePage.ApplyLayout) -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" MinWidth="330" MaxWidth="540" />
                <ColumnDefinition x:Name="ActivityColumn" Width="0" MaxWidth="560" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="20,14,20,12">
                    <controls:FileQueue x:Name="Queue" Title="FILES" EmptyText="Drop videos or audio files here" />
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,12,20,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="SAVE TO" Style="{StaticResource CardTitle}" Margin="0" />
                        <controls:OutputFolderBox x:Name="Output" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- As tall as its content: a full-height card is mostly empty on a big window -->
            <Border x:Name="OptionsCard" Grid.Column="1" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Quality" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <!-- One card per preset, added from Presets.All -->
                            <Grid x:Name="PresetChoices" ColumnSpacing="6"
                                  TabFocusNavigation="Once" AutomationProperties.Name="Quality">
                                <Grid.Resources>
                                    <Style TargetType="RadioButton" BasedOn="{StaticResource ChoiceCard}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </Grid.Resources>
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="PresetHint" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="SpeedHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Result" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <StackPanel x:Name="ResultChoices" Spacing="6"
                                        TabFocusNavigation="Once" AutomationProperties.Name="Result">
                                <StackPanel.Resources>
                                    <Style TargetType="RadioButton" BasedOn="{StaticResource ChoiceCard}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ResultCard}" />
                                    </Style>
                                </StackPanel.Resources>
                                <RadioButton Checked="OnResultChanged"
                                             AutomationProperties.Name="Subtitle file (.srt): a separate file most players pick up">
                                    <pages:ResultChoice Mode="None" Glyph="&#xE8A5;" Title="Subtitle file (.srt)"
                                                        Detail="A separate file most players pick up" />
                                </RadioButton>
                                <RadioButton Checked="OnResultChanged"
                                             AutomationProperties.Name="Subtitle track (.mkv): instant and lossless, can be turned off in the player">
                                    <pages:ResultChoice Mode="Soft" Glyph="&#xE81E;" Title="Subtitle track (.mkv)"
                                                        Detail="Instant and lossless; can be turned off" />
                                </RadioButton>
                                <RadioButton Checked="OnResultChanged"
                                             AutomationProperties.Name="Burn into the picture (.mp4): shows in every player, permanent, re-encodes the video">
                                    <pages:ResultChoice Mode="Burn" Glyph="&#xE8B9;" Title="Burn into the picture (.mp4)"
                                                        Detail="Shows in every player; re-encodes the video" />
                                </RadioButton>
                            </StackPanel>
                            <StackPanel>
                                <CheckBox x:Name="KeepSrtBox" Content="Also keep the .srt file" />
                                <CheckBox x:Name="DeleteBox" Content="Move the original to the Recycle Bin"
                                          ToolTipService.ToolTip="Only after the new video has been written. You can put it back from the finished screen or the Recycle Bin." />
                                <CheckBox x:Name="ReviewBox" Content="Review before embedding"
                                          ToolTipService.ToolTip="Stop after the subtitles are made, so you can check and edit them, then embed each file from its review. The .srt is kept for your edits." />
                            </StackPanel>
                        </StackPanel>

                        <Expander x:Name="MoreOptions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="More options: language, vocabulary, clean-up">
                            <Expander.Header>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9E9;" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="Language, vocabulary, clean-up" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="14">
                                <ComboBox x:Name="LanguageBox" Header="Language" HorizontalAlignment="Stretch" />
                                <TextBox x:Name="VocabularyBox" Header="Vocabulary" TextWrapping="Wrap"
                                         PlaceholderText="Names or words to spell correctly, comma separated" />
                                <StackPanel>
                                    <CheckBox x:Name="EnhanceBox" Content="Clean up audio first (denoise and normalize)" />
                                    <CheckBox x:Name="SkipSilenceBox" Content="Skip silent parts (faster, may drop quiet speech)" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="FinishedCard" Grid.Column="1" Style="{StaticResource Card}" Visibility="Collapsed">
                <controls:FinishedPanel x:Name="Summary" />
            </Border>

            <!-- While a batch runs, the subtitles of the file being transcribed, as they are heard -->
            <Border x:Name="LiveCard" Grid.Column="1" Style="{StaticResource Card}" Padding="20,14,20,12" Visibility="Collapsed">
                <controls:LiveTranscript x:Name="Live" />
            </Border>
        </Grid>

        <controls:RunPanel x:Name="Run" Grid.Row="1" StartText="Generate subtitles" />
    </Grid>

    <pages:ReviewPage x:Name="Review" Visibility="Collapsed" />
    </Grid>
</UserControl>
