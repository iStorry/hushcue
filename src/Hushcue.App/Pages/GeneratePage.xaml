<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Pages.GeneratePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hushcue.Controls">

    <Grid RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="INPUT" Style="{StaticResource CardTitle}" />
                        <controls:FileQueue x:Name="Queue" Grid.Row="1" EmptyText="Drop videos or audio here" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource CardTitle}" />
                        <controls:OutputFolderBox x:Name="Output" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Text="OPTIONS" Style="{StaticResource CardTitle}" Margin="0" />
                        <StackPanel Spacing="6">
                            <ComboBox x:Name="PresetBox" Header="Quality preset" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnPresetChanged" />
                            <TextBlock x:Name="PresetHint" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Header="Language" HorizontalAlignment="Stretch" />
                        <TextBox x:Name="VocabularyBox" Header="Vocabulary"
                                 PlaceholderText="Names or words to spell correctly, comma separated" />
                        <ComboBox x:Name="ResultBox" Header="Result" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnResultChanged">
                            <ToolTipService.ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="360">Burn: works in every player but cannot be switched off and re-encodes the video. Track: instant and lossless, but the player must support subtitle tracks. Your original video is never changed; a new file is written next to it (named '.subbed' if the name is taken).</TextBlock>
                            </ToolTipService.ToolTip>
                            <ComboBoxItem Content="Subtitle file only (.srt)" Tag="None" />
                            <ComboBoxItem Content="Burn into the video (permanent, re-encodes, .mp4)" Tag="Burn" />
                            <ComboBoxItem Content="Add as a subtitle track (lossless, .mkv)" Tag="Soft" />
                        </ComboBox>
                        <StackPanel>
                            <CheckBox x:Name="KeepSrtBox" Content="Also keep the .srt file" />
                            <CheckBox x:Name="DeleteBox" Content="Move the original video to the Recycle Bin when done"
                                      ToolTipService.ToolTip="Only after the new video has been written successfully. Recoverable from the Recycle Bin." />
                            <CheckBox x:Name="EnhanceBox" Content="Clean up audio first (denoise + normalize)" />
                            <CheckBox x:Name="SkipSilenceBox" Content="Skip silent parts (faster, may drop quiet speech)" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <controls:RunPanel x:Name="Run" Grid.Row="1" StartText="Generate subtitles" />
    </Grid>
</UserControl>
