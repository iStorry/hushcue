<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Pages.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hushcue.Controls">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" MinWidth="330" MaxWidth="540" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="20,14,20,12">
                    <controls:FileQueue x:Name="Queue" Title="MKV FILES" EmptyText="Drop .mkv files here" />
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,12,20,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="SAVE TO" Style="{StaticResource CardTitle}" Margin="0" />
                        <controls:OutputFolderBox x:Name="Output" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="MKV to MP4" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Removes the subtitle tracks and saves a plain .mp4. The video is not re-encoded, so quality is unchanged and it takes seconds. Subtitles that were burned into the picture cannot be removed." />
                        <StackPanel>
                            <CheckBox x:Name="SaveSrtBox" Content="Save the subtitles as an .srt file first" />
                            <CheckBox x:Name="DeleteBox" Content="Move the original .mkv to the Recycle Bin when done"
                                      ToolTipService.ToolTip="Only after the new .mp4 has been written successfully. Recoverable from the Recycle Bin." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <controls:RunPanel x:Name="Run" Grid.Row="1" StartText="Convert to MP4" />
    </Grid>
</UserControl>
