<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hushcue.Controls">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,18,0,4" />
        </Style>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4" Padding="4,8,4,24">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4"
                       AutomationProperties.HeadingLevel="Level1" />

            <TextBlock Text="Transcription" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
            <controls:SettingRow Glyph="&#xF2B7;" Title="Language"
                                 Description="The language spoken in your videos. Auto-detect listens to the first 30 seconds.">
                <ComboBox x:Name="LanguageBox" MinWidth="180" SelectionChanged="OnChanged" AutomationProperties.Name="Language" />
            </controls:SettingRow>
            <controls:SettingRow Glyph="&#xE8D2;" Title="Vocabulary" ActionBelow="True"
                                 Description="Names or words Whisper should spell your way, comma separated.">
                <TextBox x:Name="VocabularyBox" TextWrapping="Wrap" TextChanged="OnChanged"
                         PlaceholderText="e.g. Anna, Brian, Hushcue" AutomationProperties.Name="Vocabulary" />
            </controls:SettingRow>
            <controls:SettingRow Glyph="&#xE995;" Title="Clean up audio first"
                                 Description="Denoise and even out the volume before transcribing. Helps with hum and quiet speech.">
                <ToggleSwitch x:Name="EnhanceToggle" Toggled="OnChanged" AutomationProperties.Name="Clean up audio first" />
            </controls:SettingRow>
            <controls:SettingRow Glyph="&#xE916;" Title="Skip silent parts"
                                 Description="Faster on videos with long pauses, but may drop quiet or breathy speech.">
                <ToggleSwitch x:Name="SkipSilenceToggle" Toggled="OnChanged" AutomationProperties.Name="Skip silent parts" />
            </controls:SettingRow>

            <TextBlock Text="When subtitles go into the video" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
            <controls:SettingRow Glyph="&#xE8A5;" Title="Also keep the .srt file"
                                 Description="Leave the subtitles as a separate file next to the new video too.">
                <ToggleSwitch x:Name="KeepSrtToggle" Toggled="OnChanged" AutomationProperties.Name="Also keep the .srt file" />
            </controls:SettingRow>
            <controls:SettingRow Glyph="&#xE74D;" Title="Move the original to the Recycle Bin"
                                 Description="Only after the new video has been written. You can put it back from the finished screen or the Recycle Bin.">
                <ToggleSwitch x:Name="DeleteToggle" Toggled="OnChanged" AutomationProperties.Name="Move the original to the Recycle Bin" />
            </controls:SettingRow>
            <controls:SettingRow Glyph="&#xE70F;" Title="Review before embedding"
                                 Description="Stop after the subtitles are made so you can check and edit them, then embed each file from its review.">
                <ToggleSwitch x:Name="ReviewToggle" Toggled="OnChanged" AutomationProperties.Name="Review before embedding" />
            </controls:SettingRow>

            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
            <controls:SettingRow Glyph="&#xE790;" Title="Theme" Description="Light, dark, or the same as Windows.">
                <ComboBox x:Name="ThemeBox" MinWidth="180" SelectionChanged="OnChanged" AutomationProperties.Name="Theme">
                    <ComboBoxItem Content="Use Windows setting" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </controls:SettingRow>

            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
            <controls:SettingRow Glyph="&#xE895;" Title="Check for updates automatically"
                                 Description="Once a day when Hushcue starts, look for a new version on GitHub and offer to install it. Nothing else is sent.">
                <ToggleSwitch x:Name="UpdatesToggle" Toggled="OnChanged" AutomationProperties.Name="Check for updates automatically" />
            </controls:SettingRow>

            <TextBlock Text="This PC" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
            <controls:SettingRow x:Name="DeviceRow" Glyph="&#xE7F8;" Title="Where transcription runs" Description="Checking...">
                <Button Content="Run system check" Click="OnSystemCheck" />
            </controls:SettingRow>
            <controls:SettingRow x:Name="DataRow" Glyph="&#xE8B7;" Title="Models and app data">
                <Button Content="Open folder" Click="OnOpenDataFolder" AutomationProperties.Name="Open the folder with models and app data" />
            </controls:SettingRow>
        </StackPanel>
    </ScrollViewer>
</UserControl>
