<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hushcue.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- One setting: icon, what it is, and its control on the right (Windows Settings style) -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="68" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingDetail" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,18,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4" Padding="4,8,4,24">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4"
                       AutomationProperties.HeadingLevel="Level1" />

            <!-- Transcription -->
            <TextBlock Text="Transcription" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xF2B7;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Language" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="The language spoken in your videos. Auto-detect listens to the first 30 seconds." Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="2" MinWidth="180" VerticalAlignment="Center"
                              SelectionChanged="OnChanged" AutomationProperties.Name="Language" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE8D2;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Vocabulary" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Names or words Whisper should spell your way, comma separated." Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <TextBox x:Name="VocabularyBox" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" TextChanged="OnChanged"
                             PlaceholderText="e.g. Anna, Brian, Hushcue" AutomationProperties.Name="Vocabulary" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE995;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Clean up audio first" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Denoise and even out the volume before transcribing. Helps with hum and quiet speech." Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="EnhanceToggle" Grid.Column="2" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="OnChanged" AutomationProperties.Name="Clean up audio first" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE916;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Skip silent parts" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Faster on videos with long pauses, but may drop quiet or breathy speech." Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SkipSilenceToggle" Grid.Column="2" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="OnChanged" AutomationProperties.Name="Skip silent parts" />
                </Grid>
            </Border>

            <!-- Files -->
            <TextBlock Text="When subtitles go into the video" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A5;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Also keep the .srt file" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Leave the subtitles as a separate file next to the new video too." Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="KeepSrtToggle" Grid.Column="2" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="OnChanged" AutomationProperties.Name="Also keep the .srt file" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74D;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Move the original to the Recycle Bin" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Only after the new video has been written. You can put it back from the finished screen or the Recycle Bin." Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="DeleteToggle" Grid.Column="2" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="OnChanged" AutomationProperties.Name="Move the original to the Recycle Bin" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE70F;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Review before embedding" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Stop after the subtitles are made so you can check and edit them, then embed each file from its review." Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ReviewToggle" Grid.Column="2" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="OnChanged" AutomationProperties.Name="Review before embedding" />
                </Grid>
            </Border>

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Theme" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Light, dark, or the same as Windows." Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="180" VerticalAlignment="Center"
                              SelectionChanged="OnChanged" AutomationProperties.Name="Theme">
                        <ComboBoxItem Content="Use Windows setting" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Updates -->
            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE895;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Check for updates automatically" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Once a day when Hushcue starts, look for a new version on GitHub and offer to install it. Nothing else is sent." Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="UpdatesToggle" Grid.Column="2" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="OnChanged" AutomationProperties.Name="Check for updates automatically" />
                </Grid>
            </Border>

            <!-- This PC -->
            <TextBlock Text="This PC" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F8;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Where transcription runs" Style="{StaticResource SettingTitle}" />
                        <TextBlock x:Name="DeviceText" Text="Checking..." Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Run system check" Click="OnSystemCheck" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Models and app data" Style="{StaticResource SettingTitle}" />
                        <TextBlock x:Name="DataText" Style="{StaticResource SettingDetail}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open folder" Click="OnOpenDataFolder" VerticalAlignment="Center"
                            AutomationProperties.Name="Open the folder with models and app data" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
