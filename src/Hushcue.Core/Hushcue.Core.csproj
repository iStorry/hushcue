<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Silero VAD for skipping silence (CPU only): the model faster-whisper 1.2.1 ships, run the same way. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hushcue.Core.Tests" />
    <!-- the job with replaced steps, for benchmarks -->
    <InternalsVisibleTo Include="Hushcue.Cli" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Engine\silero_vad_v6.onnx" LogicalName="silero_vad_v6.onnx" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CTranslate2 bridge, built by native/build.ps1; copied next to every app that references Core. -->
    <None Include="..\..\native\bin\hushcue_ct2.dll" Condition="Exists('..\..\native\bin\hushcue_ct2.dll')"
          Link="hushcue_ct2.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- On a Mac, native/build.sh puts the bridge and the CTranslate2 dylib it loads from beside it in native/bin. -->
    <None Include="..\..\native\bin\*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
